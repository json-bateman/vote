package web

templ voteTempl(text string) {
	@Base("Vote") {
		<main class="flex-grow-1 d-flex flex-column">
			<section class="flex-grow-1 d-flex flex-wrap flex-md-nowrap">
				<button
					type="button"
					data-on:click="@post('/vote/cheer')"
					class="btn btn-success rounded-0 flex-fill w-100 fs-1 fw-bold"
				>Cheer</button>
				<button
					type="button"
					data-on:click="@post('/vote/boo')"
					class="btn btn-danger rounded-0 flex-fill w-100 fs-1 fw-bold"
				>Boo</button>
			</section>
		</main>
	}
}
