package web

import "fmt"

templ resultsTempl(t Timeline) {
	@Layout("Results", Version) {
		<main
			class="flex-grow-1 d-flex flex-column p-3"
			data-signals="{_chartJson: '', _buckets: 60}"
			data-init="@get('/sse/results')"
		>
			<div id="vote-totals" class="d-flex gap-5 mb-2">
				<div>
					<div class="text-secondary"><span class="vg-key vg-key-cheer"></span>Cheers</div>
					<div class="vg-total">{ fmt.Sprint(t.TotalCheers) }</div>
				</div>
				<div>
					<div class="text-secondary"><span class="vg-key vg-key-boo"></span>Boos</div>
					<div class="vg-total">{ fmt.Sprint(t.TotalBoos) }</div>
				</div>
			</div>
			// _buckets is local to this tab (underscore signals aren't sent to the server).
			// The morph would reset the select every frame, so it skips this block
			<div class="d-flex align-items-center gap-2 mb-1" data-ignore-morph>
				<span class="text-secondary small">Votes per 5s, last</span>
				<select class="form-select form-select-sm w-auto" data-bind:_buckets>
					<option value="12">1 minute</option>
					<option value="60" selected>5 minutes</option>
					<option value="180">15 minutes</option>
					<option value="720">1 hour</option>
				</select>
			</div>
			// ECharts draws inside this element, so the morph must skip it; the chart is
			// redrawn from the $_chartJson signal instead
			<div
				id="vote-chart"
				class="flex-grow-1"
				style="min-height: 320px"
				data-ignore-morph
				data-effect="renderVoteChart(el, $_chartJson, $theme, $_buckets)"
			></div>
		</main>
		<!-- ECharts v5.6.0 -->
		<script defer src={ StaticPath("js/echarts.min.js") }></script>
		<script defer src={ StaticPath("js/vote-chart.js") }></script>
	}
}
